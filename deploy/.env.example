# Generate all secrets with: openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_ME
SENTINELMESH_POSTGRES_PORT=15432
# Used only by the single-host protected-host profile. Keep separate from API keys.
CONTROL_PLANE_DB_PASSWORD=REPLACE_ME
DETECTION_ENGINE_KEY=REPLACE_ME
LLM_ORCHESTRATION_KEY=REPLACE_ME
SECURITY_AUTOMATION_KEY=REPLACE_ME
CONTROL_PLANE_TO_LLM_KEY=REPLACE_ME
CONTROL_PLANE_TO_HOST_AGENT_KEY=REPLACE_ME
SENTINELMESH_POLICY_SIGNING_KEY=REPLACE_ME
# API keys are caller:key pairs.
SENTINELMESH_API_KEYS=detection-engine:REPLACE_ME,llm-orchestration:REPLACE_ME,security-automation:REPLACE_ME
# Stable protected-host identity. It must match the key on the left side of
# SENTINELMESH_HOST_REGISTRY.
SENTINELMESH_HOSTNAME=sentinelmesh-host
SENTINELMESH_HOST_IP=
# Explicit host registry: hostname=http(s)://agent-endpoint, comma-separated.
SENTINELMESH_HOST_REGISTRY=sentinelmesh-host=http://host.docker.internal:9090
# For a remote/fleet host use HTTPS and pin the endpoint, or provide the host-agent via a private management network.
FALCO_IMAGE=docker.io/falcosecurity/falco:0.45.0
# Production compose uses sentinel_native automatically after native probe generation.
DETECTION_BUILD_TAGS=sentinel_native
# Optional post-incident IAM/Vault/SSO webhook.
SENTINELMESH_CREDENTIAL_REVOCATION_WEBHOOK=
SENTINELMESH_CREDENTIAL_REVOCATION_API_KEY=
SANDBOX_RUNTIME=runsc

# Local Ollama models used only after containment/reclaim.
OLLAMA_BASE_URL=http://127.0.0.1:11434
SENTINELMESH_RCA_MODEL=qwen2.5:14b
SENTINELMESH_PATCH_MODEL=qwen2.5-coder:14b
SENTINELMESH_JUDGE_MODEL=qwen2.5:14b
